# ClarifyX Backend Environment Variables Placeholder
# Copy this file to .env and configure for your environment.

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
USE_POSTGRES=false
DATABASE_URL=postgresql://user:password@localhost:5432/clarifyx_dev?schema=public
MONGODB_URI=mongodb://localhost:27017/clarifyx

# Secrets
SESSION_SECRET=your_super_secret_session_key_replace_in_production

# AI Threat Detection Providers
GOOGLE_KEY=your_gemini_api_key_here

# Storage limits (in bytes)
MAX_UPLOAD_SIZE=26214400

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
